+/** True for minor, false for major, null when the mode word is missing or unreadable. */
+private fun isMinorMode(mode: String?): Boolean? = when (mode?.lowercase()) {
+    "minor", "min", "m" -> true
+    "major", "maj" -> false
+    else -> null
+}
+
+/**
+ * A key's place on the Camelot wheel: its number 1..12 and whether it is the
+ * minor ("A") or major ("B") ring. Null when the key cannot be read.
+ *
+ * Numbers climb a fifth at a time (8B = C, 9B = G, 7B = F), and a minor key
+ * shares the number of its relative major (8A = A minor, next to 8B = C
+ * major). A key with no mode word is read in [fallbackMinor]'s mode, so that
+ * a bare "C" is compared with the other key's mode rather than guessed.
+ */
+internal data class Camelot(val number: Int, val minor: Boolean)
+
+internal fun camelotOf(key: String, fallbackMinor: Boolean = false): Camelot? {
+    val (index, modeWord) = splitKey(key)
+    if (index == null) return null
+    val minor = isMinorMode(modeWord) ?: fallbackMinor
+    // The relative major of a minor key sits a minor third above it.
+    val majorRoot = if (minor) (index + 3) % 12 else index
+    val number = (majorRoot * 7) % 12
+    return Camelot(number = (number + 7) % 12 + 1, minor = minor)
+}
+
+private fun camelotPair(left: String, right: String): Pair<Camelot, Camelot>? {
+    val leftMode = isMinorMode(splitKey(left).second)
+    val rightMode = isMinorMode(splitKey(right).second)
+    val a = camelotOf(left, fallbackMinor = rightMode ?: false) ?: return null
+    val b = camelotOf(right, fallbackMinor = leftMode ?: false) ?: return null
+    return a to b
+}
+
+/** Steps between two Camelot numbers round the wheel, 0..6. */
+private fun wheelSteps(a: Int, b: Int): Int {
+    val gap = abs(a - b) % 12
+    return min(gap, 12 - gap)
+}
+
+/**
+ * How far apart two keys sit on the Camelot wheel: the steps round the wheel,
+ * plus one when the rings differ and the numbers do not already match (a
+ * relative pair is one move, not two). Null when either key cannot be read.
+ */
+internal fun keyDistance(left: String, right: String): Int? {
+    val (a, b) = camelotPair(left, right) ?: return null
+    val steps = wheelSteps(a.number, b.number)
+    return steps + if (a.minor != b.minor && steps != 0) 1 else 0
+}
+
+/**
+ * Keys that may share a bar. On the Camelot wheel that is the same key, its
+ * relative (same number, other ring) and the fifth either side (number +-1,
+ * same ring). A semitone, a tone or a tritone apart all fall outside, even
+ * though a count of semitones would have waved some of them through.
+ */
+internal fun harmonicallyCompatible(left: String, right: String): Boolean {
+    val (a, b) = camelotPair(left, right) ?: return false
+    val steps = wheelSteps(a.number, b.number)
+    return if (a.minor == b.minor) steps <= 1 else steps == 0
 }
 
 /** A key the analyzer was not confident about is no key at all. */
