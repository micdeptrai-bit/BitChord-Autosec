+
+// --- transport -----------------------------------------------------------------
+
+// --- liquid glass ---------------------------------------------------------------
+
+/** What the glass looks through: the cover, and the size of the screen behind it. */
+@Immutable
+private data class GlassSource(val url: String?, val width: Int, val height: Int)
+
+/** Light falling across the pane from the top-left, easing off, and a faint return at the far corner. */
+private val GlassSheen = Brush.linearGradient(
+    0f to Color.White.copy(alpha = 0.22f),
+    0.38f to Color.White.copy(alpha = 0.04f),
+    0.72f to Color.White.copy(alpha = 0.01f),
+    1f to Color.White.copy(alpha = 0.12f),
+)
+
+/** Body of the pane: lit at the top, settling darker towards the bottom, like a thick lens. */
+private val GlassBody = Brush.verticalGradient(
+    0f to Color.White.copy(alpha = 0.10f),
+    0.45f to Color.White.copy(alpha = 0.02f),
+    1f to Color.Black.copy(alpha = 0.12f),
+)
+
+/** The edge: bright where the light hits it, nearly gone along the sides, bright again opposite. */
+private val GlassRim = Brush.linearGradient(
+    0f to Color.White.copy(alpha = 0.85f),
+    0.28f to Color.White.copy(alpha = 0.18f),
+    0.68f to Color.White.copy(alpha = 0.07f),
+    1f to Color.White.copy(alpha = 0.55f),
+)
+
+private val GlassTopGlint = Brush.horizontalGradient(
+    listOf(Color.Transparent, Color.White.copy(alpha = 0.70f), Color.Transparent),
+)
+
+/** Lettering that stays readable over any cover, without a visible outline. */
+private val LegibleShadow = Shadow(
+    color = Color.Black.copy(alpha = 0.34f),
+    offset = Offset(0f, 2f),
+    blurRadius = 8f,
+)
+
+/**
+ * A pane of frosted glass. Behind it sits the same cover as the screen, blurred,
+ * pushed to richer colour and lined up pixel for pixel with the sharp picture
+ * around it, so the pane reads as a lens over the cover rather than a grey
+ * rectangle laid on top.
+ *
+ * On top of that, the things that give a real pane its thickness: a body that
+ * is lit at the top and darker below, a specular bloom where the light enters
+ * at the top-left, a bounce of light along the lower edge, a lit rim and a
+ * glint on the top edge. [tint] is how much black sits under the lettering;
+ * a quieter pane (the volume bar) can take less.
+ */
+@Composable
+private fun GlassSurface(
+    glass: GlassSource,
+    shape: Shape,
+    modifier: Modifier = Modifier,
+    contentPadding: PaddingValues = PaddingValues(0.dp),
+    tint: Float = 0.20f,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    var origin by remember { mutableStateOf(Offset.Zero) }
+    Box(
+        modifier = modifier
+            .onGloballyPositioned { origin = it.positionInRoot() }
+            .clip(shape),
+    ) {
+        if (glass.width > 0 && glass.height > 0) {
+            GlassBackdropCopy(glass = glass, origin = origin, modifier = Modifier.matchParentSize())
+        }
+        Box(
+            Modifier
+                .matchParentSize()
+                .background(Color.Black.copy(alpha = tint))
+                .background(GlassBody)
+                .background(GlassSheen)
+                .drawBehind {
+                    // Where the light comes in: a bloom that fades out across the pane.
+                    drawRect(
+                        Brush.radialGradient(
+                            colors = listOf(Color.White.copy(alpha = 0.20f), Color.Transparent),
+                            center = Offset(size.width * 0.12f, 0f),
+                            radius = size.width * 0.9f,
+                        ),
+                    )
+                    // And what bounces back off the lower edge.
+                    drawRect(
+                        Brush.verticalGradient(
+                            0.66f to Color.Transparent,
+                            1f to Color.White.copy(alpha = 0.10f),
+                        ),
+                    )
+                },
+        )
+        Column(modifier = Modifier.padding(contentPadding), content = content)
+        Box(Modifier.matchParentSize().border(width = 1.2.dp, brush = GlassRim, shape = shape))
+        Box(
+            Modifier
+                .align(Alignment.TopCenter)
+                .padding(top = 1.dp)
+                .fillMaxWidth(0.55f)
+                .height(1.dp)
+                .background(GlassTopGlint),
+        )
+    }
+}
+
+/**
+ * The cover, as large as the screen, moved so that the part under the pane
+ * lands exactly where the same part of the real backdrop is. Decoded small and
+ * blurred: it only ever shows as colour and light.
+ */
+@Composable
+private fun GlassBackdropCopy(glass: GlassSource, origin: Offset, modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    val vivid = remember { ColorFilter.colorMatrix(ColorMatrix().apply { setToSaturation(1.6f) }) }
+    val shiftX = origin.x.roundToInt()
+    val shiftY = origin.y.roundToInt()
+    Box(
+        modifier = modifier.layout { measurable, constraints ->
+            val placeable = measurable.measure(Constraints.fixed(glass.width, glass.height))
+            layout(constraints.maxWidth, constraints.maxHeight) {
+                placeable.place(-shiftX, -shiftY)
+            }
+        },
+    ) {
+        AsyncImage(
+            model = remember(glass.url) {
+                ImageRequest.Builder(context).data(glass.url).size(128, 128).crossfade(500).build()
+            },
+            contentDescription = null,
+            contentScale = ContentScale.Crop,
+            colorFilter = vivid,
+            modifier = Modifier.fillMaxSize().blur(20.dp),
+        )
+    }
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+private fun TransportCard(
+    glass: GlassSource,
+    title: String,
+    artist: String,
+    isPlaying: Boolean,
+    positionMs: Long,
+    durationMs: Long,
+    onPrevious: () -> Unit,
+    onPlayPause: () -> Unit,
+    onNext: () -> Unit,
+    onSeekFraction: (Float) -> Unit,
+) {
+    val shape = RoundedCornerShape(38.dp)
+    val haptic = LocalHapticFeedback.current
+    // The fraction under the finger while scrubbing; null the rest of the time.
+    var scrub by remember { mutableStateOf<Float?>(null) }
+    val progress = if (durationMs > 0L) {
+        (positionMs.toFloat() / durationMs.toFloat()).coerceIn(0f, 1f)
+    } else {
+        0f
+    }
+    val scrubbing = scrub
+    val shownPosition = if (scrubbing != null && durationMs > 0L) (scrubbing * durationMs).toLong() else positionMs
+    val digits = TextStyle(fontFeatureSettings = "tnum", shadow = LegibleShadow)
+    // The times brighten while the bar is held, so the number being chosen reads clearly.
+    val timeAlpha by animateFloatAsState(
+        targetValue = if (scrubbing != null) 0.96f else 0.62f,
+        animationSpec = tween(durationMillis = 160),
+        label = "lockTimeAlpha",
+    )
+
+    GlassSurface(
+        glass = glass,
+        shape = shape,
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = 14.dp),
+        contentPadding = PaddingValues(start = 28.dp, end = 28.dp, top = 24.dp, bottom = 16.dp),
+    ) {
+        // The words change over with the track instead of jumping. A long title
+        // drifts sideways instead of ending in an ellipsis.
+        Crossfade(
+            targetState = title to artist,
+            animationSpec = tween(durationMillis = 320),
+            label = "lockTitle",
+        ) { (shownTitle, shownArtist) ->
+            Column {
+                Text(
+                    text = shownTitle,
+                    color = Color.White,
+                    fontSize = 22.sp,
+                    fontWeight = FontWeight.Bold,
+                    letterSpacing = (-0.3).sp,
+                    maxLines = 1,
+                    overflow = TextOverflow.Clip,
+                    style = TextStyle(shadow = LegibleShadow),
+                    modifier = Modifier.basicMarquee(),
+                )
+                Text(
+                    text = shownArtist,
+                    color = Color.White.copy(alpha = 0.68f),
+                    fontSize = 17.sp,
+                    fontWeight = FontWeight.Medium,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                    style = TextStyle(shadow = LegibleShadow),
+                )
+            }
+        }
+        Spacer(Modifier.height(14.dp))
+        ThinSlider(
+            value = scrubbing ?: progress,
+            onValueChange = { scrub = it },
+            onValueChangeFinished = {
+                val target = scrub
+                scrub = null
+                if (target != null) onSeekFraction(target)
+            },
+            idleHeight = 6.dp,
+            activeHeight = 13.dp,
+            modifier = Modifier.fillMaxWidth(),
+        )
+        Row(
+            modifier = Modifier.fillMaxWidth().padding(top = 2.dp),
+            horizontalArrangement = Arrangement.SpaceBetween,
+        ) {
+            Text(
+                text = formatTime(shownPosition),
+                color = Color.White.copy(alpha = timeAlpha),
+                fontSize = 12.sp,
+                style = digits,
+            )
+            Text(
+                text = "-" + formatTime((durationMs - shownPosition).coerceAtLeast(0L)),
+                color = Color.White.copy(alpha = timeAlpha),
+                fontSize = 12.sp,
+                style = digits,
+            )
+        }
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(top = 6.dp),
+            horizontalArrangement = Arrangement.SpaceEvenly,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            ControlButton(
+                onClick = {
+                    haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+                    onPrevious()
+                },
+                touch = 72.dp,
+            ) {
+                Icon(Icons.Rounded.SkipPrevious, contentDescription = null, tint = Color.White, modifier = Modifier.size(42.dp))
+            }
+            PlayButton(
+                isPlaying = isPlaying,
+                onClick = {
+                    haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+                    onPlayPause()
+                },
+            )
+            ControlButton(
+                onClick = {
+                    haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+                    onNext()
+                },
+                touch = 72.dp,
+            ) {
+                Icon(Icons.Rounded.SkipNext, contentDescription = null, tint = Color.White, modifier = Modifier.size(42.dp))
+            }
+        }
+    }
+}
+
+/**
+ * The play button: a small lens of its own. It sinks under the finger, lights
+ * up while held and springs back, and its glyph turns over as the state does.
+ */
+@Composable
+private fun PlayButton(isPlaying: Boolean, onClick: () -> Unit) {
+    val source = remember { MutableInteractionSource() }
+    val pressed by source.collectIsPressedAsState()
+    val scale by animateFloatAsState(
+        targetValue = if (pressed) 0.9f else 1f,
+        animationSpec = spring(dampingRatio = 0.55f, stiffness = Spring.StiffnessMedium),
+        label = "playPress",
+    )
+    val lit by animateFloatAsState(
+        targetValue = if (pressed) 1f else 0f,
+        animationSpec = tween(durationMillis = 140),
+        label = "playLit",
+    )
+    val fill = Brush.verticalGradient(
+        listOf(
+            Color.White.copy(alpha = 0.30f + 0.12f * lit),
+            Color.White.copy(alpha = 0.12f + 0.10f * lit),
+        ),
+    )
+    Box(
+        modifier = Modifier
+            .size(84.dp)
+            .graphicsLayer {
+                scaleX = scale
+                scaleY = scale
+            }
+            .clip(CircleShape)
+            .background(fill)
+            .border(1.1.dp, GlassRim, CircleShape)
+            .clickable(interactionSource = source, indication = null, onClick = onClick),
+        contentAlignment = Alignment.Center,
+    ) {
+        Crossfade(targetState = isPlaying, animationSpec = tween(220), label = "playPause") { playing ->
+            Icon(
+                imageVector = if (playing) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                contentDescription = null,
+                tint = Color.White,
+                modifier = Modifier.size(48.dp),
+            )
+        }
+    }
+}
+
+/** A transport button with no ripple: it dips under the finger and springs back. */
+@Composable
+private fun ControlButton(onClick: () -> Unit, touch: Dp, content: @Composable () -> Unit) {
+    val source = remember { MutableInteractionSource() }
+    val pressed by source.collectIsPressedAsState()
+    val scale by animateFloatAsState(
+        targetValue = if (pressed) 0.8f else 1f,
+        animationSpec = spring(dampingRatio = Spring.DampingRatioMediumBouncy, stiffness = Spring.StiffnessMedium),
+        label = "controlPress",
+    )
+    val dim by animateFloatAsState(
+        targetValue = if (pressed) 0.7f else 1f,
+        animationSpec = tween(durationMillis = 120),
+        label = "controlDim",
+    )
+    Box(
+        modifier = Modifier
+            .size(touch)
+            .graphicsLayer {
+                scaleX = scale
+                scaleY = scale
+                alpha = dim
+            }
+            .clickable(interactionSource = source, indication = null, onClick = onClick),
+        contentAlignment = Alignment.Center,
+    ) {
+        content()
+    }
+}
+
+/**
+ * The phone's media volume, between a quiet and a loud speaker, on the same bar
+ * the player's own volume uses. It follows the hardware keys and changes
+ * of output, and never fights the finger that is moving it.
+ */
+@Composable
+private fun VolumeBar(modifier: Modifier = Modifier) {
+    val volume = remember { PlayerPlatform.host.volume }
+    val systemLevel by volume.level.collectAsStateWithLifecycle()
+    var level by remember { mutableFloatStateOf(systemLevel) }
+    var dragging by remember { mutableStateOf(false) }
+
+    LaunchedEffect(Unit) { volume.refresh() }
+    LaunchedEffect(systemLevel) {
+        if (!dragging) level = systemLevel
+    }
+
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Icon(
+            Icons.AutoMirrored.Rounded.VolumeDown,
+            contentDescription = null,
+            tint = Color.White.copy(alpha = 0.6f),
+            modifier = Modifier.size(22.dp),
+        )
+        Spacer(Modifier.width(10.dp))
+        ThinSlider(
+            value = level,
+            onValueChange = {
+                dragging = true
+                level = it
+                volume.set(it)
+            },
+            onValueChangeFinished = {
+                dragging = false
+                volume.refresh()
+            },
+            idleHeight = 6.dp,
+            activeHeight = 10.dp,
+            modifier = Modifier.weight(1f),
+        )
+        Spacer(Modifier.width(10.dp))
+        Icon(
+            Icons.AutoMirrored.Rounded.VolumeUp,
+            contentDescription = null,
+            tint = Color.White.copy(alpha = 0.6f),
+            modifier = Modifier.size(22.dp),
+        )
+    }
+}
+
+private fun formatTime(ms: Long): String {
+    val totalSeconds = (ms / 1000L).coerceAtLeast(0L)
+    return String.format(Locale.ROOT, "%d:%02d", totalSeconds / 60L, totalSeconds % 60L)
+}
