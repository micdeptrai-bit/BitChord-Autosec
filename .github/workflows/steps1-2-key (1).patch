+// actually cares about: how much better is the winner than the best key it
+// could *not* be mixed with? Doubt between a key and its relative or its
+// fifth costs nothing -- those mix -- so it does not lower the confidence;
+// doubt between, say, C major and D major does. Scaled further by how well
+// the winner fits at all, so a flat, atonal chroma is never "confident".
+KeyEstimate EstimateKey(const std::array<double, 12>& chroma) {
+  KeyEstimate estimate;
+  double total = 0;
+  for (double v : chroma) total += v;
+  if (total <= 0) return estimate;
+
+  struct Candidate { double r; size_t root; bool minor; };
+  std::array<Candidate, 24> candidates;
+  for (size_t root = 0; root < 12; ++root) {
+    candidates[root * 2] = {ProfileCorrelation(chroma, kMajorProfile, root), root, false};
+    candidates[root * 2 + 1] = {ProfileCorrelation(chroma, kMinorProfile, root), root, true};
+  }
+  const Candidate best = *std::max_element(
+    candidates.begin(), candidates.end(),
+    [](const Candidate& a, const Candidate& b) { return a.r < b.r; });
