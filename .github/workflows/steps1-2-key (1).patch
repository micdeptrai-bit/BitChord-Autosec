+  const double fit = Clamp((best.r - 0.30) / 0.40, 0, 1);
+  estimate.name = std::string(kKeyNames[best.root]) + (best.minor ? " minor" : " major");
+  estimate.confidence = margin * fit;
+  return estimate;
