+// The track's tuning offset in semitones (-0.5..0.5), from the fractional part
+// of every peak's note number. Zero unless one offset clearly dominates, so a
+// track with no steady tuning reference is left as it is.
+double EstimateTuning(const std::vector<KeyFrame>& frames) {
+  std::array<double, kTuningBins> histogram{};
+  double total = 0;
+  for (const KeyFrame& frame : frames) {
+    for (const PeakNote& peak : frame.peaks) {
+      const double fraction = peak.position - std::floor(peak.position + 0.5);
+      int bin = static_cast<int>(std::floor((fraction + 0.5) * kTuningBins));
+      bin = ((bin % kTuningBins) + kTuningBins) % kTuningBins;
+      histogram[bin] += peak.weight;
+      total += peak.weight;
+    }
+  }
+  if (total <= 0) return 0;
+  std::array<double, kTuningBins> smoothed{};
+  for (int bin = 0; bin < kTuningBins; ++bin) {
+    smoothed[bin] = histogram[(bin + kTuningBins - 1) % kTuningBins] +
+                    2.0 * histogram[bin] +
+                    histogram[(bin + 1) % kTuningBins];
+  }
+  int best = 0;
+  for (int bin = 1; bin < kTuningBins; ++bin) if (smoothed[bin] > smoothed[best]) best = bin;
+  const double mean = 4.0 * total / kTuningBins;
+  if (smoothed[best] < 1.4 * mean) return 0;
+  return (best + 0.5) / kTuningBins - 0.5;
