+// Pearson correlation of a chroma vector with a key profile rotated to `root`.
+// Correlation, not a raw dot product: a dot product rewards whichever profile
+// has the larger sum, which is how a few bass notes could pull the answer to
+// the wrong mode. Both sides are centred, so only the *shape* is compared.
+double ProfileCorrelation(
+  const std::array<double, 12>& chroma,
+  const std::array<double, 12>& profile,
+  size_t root
+) {
+  double chroma_mean = 0;
+  double profile_mean = 0;
+  for (size_t i = 0; i < 12; ++i) {
+    chroma_mean += chroma[i];
+    profile_mean += profile[i];
+  }
+  chroma_mean /= 12;
+  profile_mean /= 12;
+  double covariance = 0;
+  double chroma_var = 0;
+  double profile_var = 0;
+  for (size_t pitch = 0; pitch < 12; ++pitch) {
+    const double c = chroma[pitch] - chroma_mean;
+    const double p = profile[(pitch + 12 - root) % 12] - profile_mean;
+    covariance += c * p;
+    chroma_var += c * c;
+    profile_var += p * p;
+  }
+  const double denominator = std::sqrt(chroma_var * profile_var);
+  return denominator > 1e-12 ? covariance / denominator : 0.0;
+}
