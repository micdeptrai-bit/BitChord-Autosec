+package com.music.bitchord.playback.smart
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+/**
+ * Key compatibility on the Camelot wheel: same key, relative major/minor and a
+ * fifth either side mix; a semitone, a tone or a tritone do not. The analyzer
+ * names keys like "C♯ minor" and "E♭ major" (UTF-8 accidentals, no flats for C♯).
+ */
+class KeyCompatibilityTest {
+
+    private fun compatible(a: String, b: String) = harmonicallyCompatible(a, b)
+
+    // --- the wheel itself -------------------------------------------------
+
+    @Test
+    fun camelotCodesMatchTheWheel() {
+        assertEquals(Camelot(8, minor = false), camelotOf("C major"))
+        assertEquals(Camelot(8, minor = true), camelotOf("A minor"))
+        assertEquals(Camelot(9, minor = false), camelotOf("G major"))
+        assertEquals(Camelot(7, minor = false), camelotOf("F major"))
+        assertEquals(Camelot(1, minor = false), camelotOf("B major"))
+        assertEquals(Camelot(5, minor = true), camelotOf("C minor"))
+        assertEquals(Camelot(12, minor = true), camelotOf("C♯ minor"))
+        assertEquals(Camelot(2, minor = false), camelotOf("F♯ major"))
+        assertEquals(Camelot(5, minor = false), camelotOf("E♭ major"))
+        assertEquals(Camelot(2, minor = true), camelotOf("E♭ minor"))
+    }
+
+    @Test
+    fun enharmonicSpellingsLandOnTheSameCode() {
+        assertEquals(camelotOf("C♯ major"), camelotOf("D♭ major"))
+        assertEquals(camelotOf("F♯ minor"), camelotOf("G♭ minor"))
+    }
+
+    // --- compatible pairs -------------------------------------------------
+
+    @Test
+    fun sameKeyMixes() {
+        assertTrue(compatible("A minor", "A minor"))
+        assertTrue(compatible("E♭ major", "E♭ major"))
+    }
+
+    @Test
+    fun relativePairMixes() {
+        assertTrue(compatible("C major", "A minor"))
+        assertTrue(compatible("A minor", "C major"))
+        assertTrue(compatible("E♭ major", "C minor"))
+        assertTrue(compatible("F♯ minor", "A major"))
+    }
+
+    @Test
+    fun fifthEitherSideMixesInTheSameMode() {
+        assertTrue(compatible("C major", "G major"))
+        assertTrue(compatible("C major", "F major"))
+        assertTrue(compatible("A minor", "E minor"))
+        assertTrue(compatible("A minor", "D minor"))
+    }
+
+    @Test
+    fun wheelWrapsAroundAtTwelve() {
+        // B major is 1B and E major is 12B: neighbours across the seam.
+        assertTrue(compatible("B major", "E major"))
+        assertTrue(compatible("E major", "B major"))
+        // C♯ minor is 12A, G♯ minor is 1A.
+        assertTrue(compatible("C♯ minor", "G♯ minor"))
+    }
+
+    // --- clashing pairs ---------------------------------------------------
+
+    @Test
+    fun semitoneApartClashes() {
+        assertFalse(compatible("C major", "C♯ major"))
+        assertFalse(compatible("A minor", "B♭ minor"))
+        assertFalse(compatible("C major", "B major"))
+    }
+
+    @Test
+    fun wholeToneApartClashes() {
+        // Two moves round the wheel, which a semitone count let through.
+        assertFalse(compatible("C major", "D major"))
+        assertFalse(compatible("A minor", "B minor"))
+    }
+
+    @Test
+    fun tritoneClashes() {
+        assertFalse(compatible("C major", "F♯ major"))
+        assertFalse(compatible("A minor", "E♭ minor"))
+    }
+
+    @Test
+    fun neighbourOnTheOtherRingClashes() {
+        // 8B against 7A and 8B against 8A: only the second, the relative, is one move.
+        assertFalse(compatible("C major", "D minor"))
+        assertFalse(compatible("C major", "E minor"))
+        assertTrue(compatible("C major", "A minor"))
+    }
+
+    @Test
+    fun compatibilityIsSymmetric() {
+        val keys = listOf(
+            "C major", "C♯ major", "D major", "E♭ major", "E major", "F major",
+            "F♯ major", "G major", "A♭ major", "A major", "B♭ major", "B major",
+            "C minor", "C♯ minor", "D minor", "E♭ minor", "E minor", "F minor",
+            "F♯ minor", "G minor", "G♯ minor", "A minor", "B♭ minor", "B minor",
+        )
+        for (a in keys) for (b in keys) {
+            assertEquals(compatible(a, b), compatible(b, a), "$a vs $b")
+        }
+    }
+
+    @Test
+    fun eachKeyHasExactlyThreeFriends() {
+        val keys = listOf(
+            "C major", "C♯ major", "D major", "E♭ major", "E major", "F major",
+            "F♯ major", "G major", "A♭ major", "A major", "B♭ major", "B major",
+            "C minor", "C♯ minor", "D minor", "E♭ minor", "E minor", "F minor",
+            "F♯ minor", "G minor", "G♯ minor", "A minor", "B♭ minor", "B minor",
+        )
+        for (a in keys) {
+            val friends = keys.count { it != a && compatible(a, it) }
+            assertEquals(3, friends, "$a")
+        }
+    }
+
+    // --- unreadable input -------------------------------------------------
+
+    @Test
+    fun unreadableKeyIsNeverCompatible() {
+        assertFalse(compatible("", "C major"))
+        assertFalse(compatible("C major", "H major"))
+        assertNull(keyDistance("", "C major"))
+    }
+
+    @Test
+    fun missingModeTakesTheOtherKeysMode() {
+        assertTrue(compatible("C", "G major"))
+        assertTrue(compatible("A minor", "E"))
+    }
+
+    // --- distance ---------------------------------------------------------
+
+    @Test
+    fun distanceCountsWheelMovesNotSemitones() {
+        assertEquals(0, keyDistance("C major", "C major"))
+        assertEquals(0, keyDistance("C major", "A minor"))
+        assertEquals(1, keyDistance("C major", "G major"))
+        assertEquals(2, keyDistance("C major", "D major"))
+        assertEquals(6, keyDistance("C major", "F♯ major"))
+        assertEquals(keyDistance("G major", "C major"), keyDistance("C major", "G major"))
+    }
+
+    // --- which key a mix is judged by --------------------------------------
+
+    private fun track(
+        key: String = "",
+        keyConfidence: Double = 0.0,
+        keyStart: String = "",
+        keyStartConfidence: Double = 0.0,
+        keyEnd: String = "",
+        keyEndConfidence: Double = 0.0,
+    ) = TrackAnalysis(
+        key = key,
+        keyConfidence = keyConfidence,
+        keyStart = keyStart,
+        keyStartConfidence = keyStartConfidence,
+        keyEnd = keyEnd,
+        keyEndConfidence = keyEndConfidence,
+    )
+
+    @Test
+    fun exitKeyPrefersTheClosingStretch() {
+        val modulates = track("C major", 0.9, keyEnd = "E major", keyEndConfidence = 0.8)
+        assertEquals("E major", exitKey(modulates))
+    }
+
+    @Test
+    fun entryKeyPrefersTheOpeningStretch() {
+        val opensElsewhere = track("C major", 0.9, keyStart = "A♭ major", keyStartConfidence = 0.8)
+        assertEquals("A♭ major", entryKey(opensElsewhere))
+    }
+
+    @Test
+    fun unsureStretchFallsBackToTheWholeTrackKey() {
+        val unsure = track("C major", 0.9, "D major", 0.1, "F♯ major", 0.1)
+        assertEquals("C major", entryKey(unsure))
+        assertEquals("C major", exitKey(unsure))
+    }
+
+    @Test
+    fun noKeyAtAllStaysBlank() {
+        assertEquals("", exitKey(track()))
+        assertEquals("", entryKey(track("C major", keyConfidence = 0.1)))
+    }
+
+    @Test
+    fun modulatingSongIsJudgedByWhereItEnds() {
+        // C major overall, but it finishes in E major: E major into B major mixes,
+        // whereas the whole-track C major into B major would have been refused.
+        val out = track("C major", 0.9, keyEnd = "E major", keyEndConfidence = 0.8)
+        val next = track("B major", 0.9)
+        assertTrue(compatible(exitKey(out), entryKey(next)))
+        assertFalse(compatible(out.key, next.key))
+    }
+}
