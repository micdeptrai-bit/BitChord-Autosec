+// Camelot number 1..12 of a key (its relative major's place round the circle
+// of fifths); the same arithmetic as the planner's harmonicallyCompatible.
+int CamelotNumber(size_t root, bool minor) {
+  const size_t major_root = minor ? (root + 3) % 12 : root;
+  return static_cast<int>((major_root * 7) % 12 + 7) % 12 + 1;
+}
+
+// Keys a DJ would happily mix into each other: the same key, its relative, and
+// the fifth either side in the same mode.
+bool CamelotCompatible(size_t root_a, bool minor_a, size_t root_b, bool minor_b) {
+  const int a = CamelotNumber(root_a, minor_a);
+  const int b = CamelotNumber(root_b, minor_b);
+  const int gap = std::abs(a - b) % 12;
+  const int steps = std::min(gap, 12 - gap);
+  return minor_a == minor_b ? steps <= 1 : steps == 0;
